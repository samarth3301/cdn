# Server configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=9876

# MongoDB configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=cdn_storage

# Authentication
REGISTRATION_TOKEN=your_secret_registration_token

# Cache configuration
CACHE_MAX_CAPACITY=1000
CACHE_TTL_SECONDS=3600

# Logging
RUST_LOG=info
LOG_FORMAT=default
